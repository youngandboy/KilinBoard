import os
from building import *

cwd = GetCurrentDir()

src = []
src += Glob('*.c')
src += Glob('board/*.c')
src += Glob('drivers/*.c')
src += Glob('services/*.c')
src += Glob('tasks/*.c')
src += Glob('shell/*.c')
src += Glob('port/*.c')

# The desk-companion image keeps the recovery bootloader but disables the
# application-side OTA client to preserve flash headroom.
src = [s for s in src if s.name not in ('svc_ota.c', 'msh_ota.c')]

path = [cwd]
path += [os.path.join(cwd, '..', '..', '..', '..')]
path += [os.path.join(cwd, 'board')]
path += [os.path.join(cwd, 'drivers')]
path += [os.path.join(cwd, 'services')]
path += [os.path.join(cwd, 'tasks')]
path += [os.path.join(cwd, 'shell')]
path += [os.path.join(cwd, 'port')]

at_device_inc = os.path.join(cwd, '..', 'packages', 'at_device-latest', 'inc')
at_device_esp = os.path.join(cwd, '..', 'packages', 'at_device-latest', 'class', 'esp8266')
if os.path.isdir(at_device_inc):
    path += [at_device_inc]
if os.path.isdir(at_device_esp):
    path += [at_device_esp]

group = DefineGroup('app', src, depend=[''], CPPPATH=path)
Return('group')
